{
    "id": "processing/preprocess/binarize",
    "name": "二值化",
    "description": "图像二值化：固定阈值、自适应阈值、Otsu自动阈值",
    "version": "1.0.0",
    "inputs": [
        {
            "name": "images",
            "type": "image",
            "label": "图像输入"
        }
    ],
    "outputs": [
        {
            "name": "images",
            "type": "image",
            "label": "二值图像"
        },
        {
            "name": "mask",
            "type": "image",
            "label": "掩码输出"
        }
    ],
    "params": [
        {
            "name": "method",
            "type": "combo",
            "label": "二值化方法",
            "default": "otsu",
            "options": [
                {
                    "value": "fixed",
                    "label": "固定阈值"
                },
                {
                    "value": "adaptive_mean",
                    "label": "自适应均值"
                },
                {
                    "value": "adaptive_gaussian",
                    "label": "自适应高斯"
                },
                {
                    "value": "otsu",
                    "label": "Otsu自动"
                }
            ]
        },
        {
            "name": "threshold_value",
            "type": "int_slider",
            "label": "阈值",
            "default": 128,
            "min": 0,
            "max": 255,
            "step": 1
        },
        {
            "name": "block_size",
            "type": "int_slider",
            "label": "块大小 (自适应)",
            "default": 11,
            "min": 3,
            "max": 99,
            "step": 2
        },
        {
            "name": "c_value",
            "type": "int_slider",
            "label": "C值 (自适应)",
            "default": 2,
            "min": -10,
            "max": 10,
            "step": 1
        }
    ]
}
