{
    "id": "processing/brightness/brightness",
    "name": "亮度对比度",
    "category": "图像处理",
    "subcategory": "预处理",
    "description": "调整图像亮度、对比度，支持CLAHE自适应均衡化",
    "version": "1.0.0",
    "inputs": [
        {"name": "images", "type": "image", "label": "图像输入"}
    ],
    "outputs": [
        {"name": "images", "type": "image", "label": "图像输出"}
    ],
    "params": [
        {
            "name": "brightness",
            "type": "int_slider",
            "label": "亮度",
            "default": 0,
            "min": -100,
            "max": 100,
            "step": 1
        },
        {
            "name": "contrast",
            "type": "float_slider",
            "label": "对比度",
            "default": 1.0,
            "min": 0.5,
            "max": 3.0,
            "step": 0.1
        },
        {
            "name": "clahe",
            "type": "checkbox",
            "label": "CLAHE",
            "default": false,
            "pinned": true
        },
        {
            "name": "clahe_clip",
            "type": "int_slider",
            "label": "CLAHE裁剪限制",
            "default": 2,
            "min": 1,
            "max": 10,
            "step": 1
        }
    ]
}
