{
    "id": "detection/yolo/yolo_detect",
    "name": "YOLO 检测",
    "category": "检测",
    "subcategory": "",
    "description": "使用 YOLOv8+ 模型进行目标检测，支持读取模型类别和输出标注图像",
    "version": "1.0.0",
    "icon": "",
    "inputs": [
        {
            "name": "images",
            "type": "image",
            "label": "图像输入"
        }
    ],
    "outputs": [
        {
            "name": "rois",
            "type": "roi",
            "label": "检测区域"
        }
    ],
    "optional_ports": [
        {"name": "roi", "label": "ROI 输入", "port_type": "roi", "direction": "input", "default": false, "group": "input"},
        {"name": "forbidden", "label": "禁止区域", "port_type": "roi", "direction": "input", "default": false, "group": "input"}
    ],
    "params": [
        {
            "name": "model_path",
            "type": "file_list",
            "label": "模型文件 (.pt)",
            "default": [],
            "filters": "YOLO 模型 (*.pt);;所有文件 (*)",
            "multi": false
        },
        {
            "name": "conf_threshold",
            "type": "float_slider",
            "label": "置信度阈值",
            "default": 0.25,
            "min": 0.0,
            "max": 1.0,
            "step": 0.05
        },
        {
            "name": "iou_threshold",
            "type": "float_slider",
            "label": "IoU 阈值 (NMS)",
            "default": 0.45,
            "min": 0.0,
            "max": 1.0,
            "step": 0.05
        }
    ]
}
