{
    "id": "detection/shape_detection/polygon",
    "name": "多边形检测",
    "category": "检测",
    "subcategory": "形状检测",
    "description": "检测图像中的多边形（待实现）",
    "version": "1.0.0",
    "icon": "",
    "inputs": [
        {
            "name": "images",
            "type": "image",
            "label": "图像输入"
        }
    ],
    "outputs": [
        {
            "name": "rois",
            "type": "roi",
            "label": "检测区域"
        }
    ],
    "optional_ports": [
        {"name": "roi", "label": "ROI 输入", "port_type": "roi", "direction": "input", "default": false, "group": "input"},
        {"name": "forbidden", "label": "禁止区域", "port_type": "roi", "direction": "input", "default": false, "group": "input"},
        {"name": "annotated", "label": "标注图像", "port_type": "image", "direction": "output", "default": false, "group": "output"}
    ],
    "params": [
        {
            "name": "detection_method",
            "type": "combo",
            "label": "检测方法",
            "default": "contour",
            "options": [
                {"value": "contour", "label": "轮廓检测"}
            ]
        },
        {
            "name": "epsilon_factor",
            "type": "float_slider",
            "label": "近似精度系数",
            "default": 0.02,
            "min": 0.001,
            "max": 0.1,
            "step": 0.001
        },
        {
            "name": "min_area",
            "type": "int_slider",
            "label": "最小面积",
            "default": 500,
            "min": 50,
            "max": 10000,
            "step": 50
        }
    ]
}
