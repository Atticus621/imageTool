{
    "id": "detection/shape/circle_detect",
    "name": "圆形检测",
    "description": "使用霍夫圆变换检测图像中的圆形",
    "version": "1.0.0",
    "icon": "",
    "inputs": [
        {
            "name": "images",
            "type": "image",
            "label": "图像输入"
        }
    ],
    "outputs": [
        {
            "name": "rois",
            "type": "roi",
            "label": "检测区域"
        }
    ],
    "optional_ports": [
        {
            "name": "roi",
            "label": "ROI 输入",
            "port_type": "roi",
            "direction": "input",
            "default": false,
            "group": "input"
        },
        {
            "name": "forbidden",
            "label": "禁止区域",
            "port_type": "roi",
            "direction": "input",
            "default": false,
            "group": "input"
        },
        {
            "name": "images",
            "label": "标注图像",
            "port_type": "image",
            "direction": "output",
            "default": false,
            "group": "output"
        },
        {
            "name": "count",
            "label": "检测数量",
            "port_type": "number",
            "direction": "output",
            "default": false,
            "group": "output"
        },
        {
            "name": "stats",
            "label": "统计信息",
            "port_type": "string",
            "direction": "output",
            "default": false,
            "group": "output"
        }
    ],
    "params": [
        {
            "name": "detection_method",
            "type": "combo",
            "label": "检测方法",
            "default": "hough",
            "options": [
                {
                    "value": "hough",
                    "label": "基尔霍夫检测"
                }
            ]
        },
        {
            "name": "dp",
            "type": "float_slider",
            "label": "累加器分辨率比",
            "default": 1.2,
            "min": 1.0,
            "max": 3.0,
            "step": 0.1
        },
        {
            "name": "min_dist",
            "type": "int_slider",
            "label": "圆心最小距离",
            "default": 50,
            "min": 10,
            "max": 500,
            "step": 5
        },
        {
            "name": "param1",
            "type": "int_slider",
            "label": "Canny高阈值",
            "default": 100,
            "min": 10,
            "max": 500,
            "step": 5
        },
        {
            "name": "param2",
            "type": "int_slider",
            "label": "累加器阈值",
            "default": 30,
            "min": 5,
            "max": 200,
            "step": 1
        },
        {
            "name": "min_radius",
            "type": "int_slider",
            "label": "最小半径",
            "default": 10,
            "min": 0,
            "max": 500,
            "step": 1
        },
        {
            "name": "max_radius",
            "type": "int_slider",
            "label": "最大半径",
            "default": 200,
            "min": 0,
            "max": 1000,
            "step": 5
        }
    ]
}
